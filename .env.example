# case-service — every variable the service reads (SPEC-PLAT-06 R78). Copy to .env (git-ignored).
# Values below are DEV-ONLY and target the growercare-local-platform network (container hostnames).
# Production: injected from AWS Secrets Manager via External Secrets (never committed).

# --- required (no defaults; the service refuses to start without them)
# JDBC URL of the sharded gc_case database
DB_URL=jdbc:postgresql://postgres:5432/gc_case
# runtime role (DML only) and its password (secret)
DB_APP_USER=gc_case_app
DB_APP_PASSWORD=dev_case_app_pw
# Debezium login role granted on every shard outbox (migrations)
GC_CDC_ROLE=gc_cdc
# expected token issuer (iss claim), where signing keys are fetched, where service tokens are requested
OIDC_ISSUER_URI=http://localhost:8180/realms/growercare
OIDC_JWKS_URI=http://keycloak:8180/realms/growercare/protocol/openid-connect/certs
OIDC_TOKEN_URI=http://keycloak:8180/realms/growercare/protocol/openid-connect/token
# identity-access-service (network only) and this service's Keycloak client for /internal calls (secret)
IAM_BASE_URL=http://identity-access-service:8081
IAM_CLIENT_ID=case-service
IAM_CLIENT_SECRET=dev-case-service-secret
# grower-service (network only): the grower replica's source (SPEC-CASE-06)
GROWER_BASE_URL=http://grower-service:8084
# principal cache (Redis is never a system of record)
REDIS_HOST=redis
REDIS_PASSWORD=dev_redis_pw
# Kafka brokers (grant events in, DLQ out)
KAFKA_BOOTSTRAP_SERVERS=kafka:9092
# attachments: region and buckets
S3_REGION=us-east-1
S3_STAGING_BUCKET=gc-media-staging
S3_CLEAN_BUCKET=gc-media-clean
S3_QUARANTINE_BUCKET=gc-media-quarantine

# --- S3 outside AWS (leave EMPTY in AWS: regional endpoint + IRSA credentials)
# address the service uses, and the address written into presigned URLs (SPEC-CASE-05 R115)
S3_ENDPOINT=http://seaweedfs:8333
S3_PUBLIC_ENDPOINT=http://localhost:8333
S3_ACCESS_KEY=gc-dev-access
S3_SECRET_KEY=gc-dev-secret
# SeaweedFS does not verify x-amz-checksum-sha256 (the scan job re-checks SHA-256); default true
S3_SIGN_CHECKSUM=false
# create the buckets at startup (local only); default false
S3_CREATE_BUCKETS=true

# --- migrations (only where they run: locally, or the pre-deploy Job)
# default false
GC_MIGRATE=true
DB_OWNER_USER=gc_case_owner
DB_OWNER_PASSWORD=dev_case_owner_pw
# dev users, growers, products (local only); default false
GC_DEV_SEED=true
GC_MIGRATE_PARALLELISM=8

# --- optional tunables (safe defaults)
SERVER_PORT=8082
DB_POOL_SIZE=20
REDIS_PORT=6379
GC_EVENTS_CONSUMERS_ENABLED=true
# default: none
GC_CORS_ALLOWED_ORIGINS=http://localhost:5173
# Swagger UI only locally; default false
GC_API_DOCS_ENABLED=true
JAVA_TOOL_OPTIONS=-Xmx768m
